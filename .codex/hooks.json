{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/root/agent-engineer/hooks/ae_hook.py\" session-start --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/root/agent-engineer/hooks/ae_hook.py\" prompt-submit --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/root/agent-engineer/hooks/ae_hook.py\" pre-write --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/root/agent-engineer/hooks/ae_hook.py\" post-write --harness codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/root/agent-engineer/hooks/ae_hook.py\" post-bash --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/root/agent-engineer/hooks/ae_hook.py\" stop --harness codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
